#!/usr/bin/env bash
# pre-commit — context-hygiene guard.
#
# GENERATED by create-context-hygiene. Do not hand-edit; re-run the generator.
#
# The fast local guard, using an offline token counter so it costs milliseconds
# and needs no network or API key. It runs on every commit rather than only when
# an instruction file is staged: a budget covers a TOTAL, so adding a skill or a
# new @-import anywhere can break it without touching CLAUDE.md at all.
#
# This hook is bypassable with `git commit --no-verify`. That makes it a warning
# you can act on early, not the gate — CI runs the same checks and is the thing
# that actually holds the line.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
HYGIENE="$ROOT/{{HYGIENE_DIR}}"
[[ -d "$HYGIENE" ]] || exit 0
[[ -f "$ROOT/.context-budget.toml" ]] || exit 0

PY="$(command -v python3 || command -v python)" || {
    echo "context-hygiene: no python3 on PATH — skipping the local check." >&2
    exit 0
}

status=0

"$PY" "$HYGIENE/check_budget.py" --root "$ROOT" --counter {{HOOK_COUNTER}} --quiet || status=1

if [[ -f "$HYGIENE/context_lint.py" ]]; then
    "$PY" "$HYGIENE/context_lint.py" --root "$ROOT" --counter {{HOOK_COUNTER}} --quiet || status=1
fi

if [[ $status -ne 0 ]]; then
    cat >&2 <<'MSG'

------------------------------------------------------------------
Commit blocked: the always-on instruction set is over budget or has
content that belongs in a skill or a reference doc.

  Where things go:   docs/PLACEMENT.md
  Re-check:          python3 {{HYGIENE_DIR}}/check_budget.py

This hook uses an offline approximate counter and can be bypassed
with --no-verify. CI runs the same checks and cannot be, so a bypass
here defers the failure rather than avoiding it.
------------------------------------------------------------------
MSG
fi

exit $status
